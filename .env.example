# MODE=mock runs entirely offline on seeded disputes (default). MODE=sandbox talks to PayPal sandbox.
MODE=mock

# Only needed when MODE=sandbox. Never commit real values.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# Optional. Without a key the agent replays recorded responses from fixtures/llm-cache.
ANTHROPIC_API_KEY=

# Optional real model via NVIDIA's free OpenAI-compatible API (build.nvidia.com). Placeholder only.
NVIDIA_API_KEY=
NVIDIA_MODEL=mistralai/mistral-large-4-1t-a52b

# anthropic | nvidia | replay. Default: anthropic if ANTHROPIC_API_KEY, else nvidia if NVIDIA_API_KEY, else replay.
LLM_PROVIDER=

PORT=3000

# Bind address. Keep loopback unless you add your own auth in front.
HOST=127.0.0.1
# Extra Host headers to accept (comma separated). Leave unset unless you serve under another name.
# ALLOWED_HOSTS=
