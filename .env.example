# MODE=mock runs entirely offline on seeded disputes (default). MODE=sandbox talks to PayPal sandbox.
MODE=mock

# Only needed when MODE=sandbox. Never commit real values.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# Optional. Without a key the agent replays recorded responses from fixtures/llm-cache.
ANTHROPIC_API_KEY=

PORT=3000
